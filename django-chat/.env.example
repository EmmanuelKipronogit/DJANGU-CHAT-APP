# --- Core ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when serving over https behind a proxy, e.g. https://chat.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (leave empty to use local SQLite) ---
# DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# --- Redis for the Channels layer (leave empty for in-memory, single process only) ---
# REDIS_URL=redis://localhost:6379/0

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorised redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (used to send the verification code) ---
# Leave EMAIL_HOST empty in development: codes are printed to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Chat <no-reply@example.com>

# --- 2FA ---
TWO_FACTOR_CODE_TTL_SECONDS=600
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RESEND_COOLDOWN_SECONDS=30
